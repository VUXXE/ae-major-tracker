{
  "name": "ae-major-tracker",
  "compatibility_date": "2026-10-06",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "ae.asy.web.id",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "HLTV_API",
      "service": "hltv-api"
    }
  ]
}
